<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict><key>%@ · %lld턴</key><dict><key>NSStringLocalizedFormatKey</key><string>%@ · %#@n@</string><key>n</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld turn</string><key>other</key><string>%lld turns</string></dict></dict><key>%lld턴</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@n@</string><key>n</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld turn</string><key>other</key><string>%lld turns</string></dict></dict><key>검색 결과 %lld개</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@n@</string><key>n</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld result</string><key>other</key><string>%lld results</string></dict></dict><key>고른 대화 %lld개를 새 공간에도 놓아요. 지금 공간에도 그대로 있어요.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@n@</string><key>n</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>Also shows the selected conversation in the new workspace. It stays in this one too.</string><key>other</key><string>Also shows the %lld selected conversations in the new workspace. They stay in this one too.</string></dict></dict><key>고른 대화 %lld개와 그 터미널 탭을 새 공간으로 옮겨요.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@n@</string><key>n</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>Moves the selected conversation and its terminal tab to the new workspace.</string><key>other</key><string>Moves the %lld selected conversations and their terminal tabs to the new workspace.</string></dict></dict><key>대화 %lld개</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@n@</string><key>n</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld conversation</string><key>other</key><string>%lld conversations</string></dict></dict><key>대화 %lld개 — 놓으면 추가</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@n@</string><key>n</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld conversation — drop to add</string><key>other</key><string>%lld conversations — drop to add</string></dict></dict><key>안 읽은 알림 %lld개</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@n@</string><key>n</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld unread alert</string><key>other</key><string>%lld unread alerts</string></dict></dict><key>알림 %lld개</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@n@</string><key>n</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld alert</string><key>other</key><string>%lld alerts</string></dict></dict><key>연결된 %lld개 같이 옮기기</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@n@</string><key>n</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>Move %lld Linked Together</string><key>other</key><string>Move %lld Linked Together</string></dict></dict><key>이 셸에서 프로그램 %lld개가 돌고 있어요</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@n@</string><key>n</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld program is running in this shell</string><key>other</key><string>%lld programs are running in this shell</string></dict></dict><key>이 폴더를 고른 대화 %lld개에서도 빠져요. 그 대화들은 남은 작업 폴더만 쓰게 돼요.</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@n@</string><key>n</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>It's also removed from the %lld conversation that chose it. It keeps only its other work folders.</string><key>other</key><string>It's also removed from the %lld conversations that chose it. They keep only their other work folders.</string></dict></dict><key>탭 %lld개</key><dict><key>NSStringLocalizedFormatKey</key><string>%#@n@</string><key>n</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string><key>one</key><string>%lld tab</string><key>other</key><string>%lld tabs</string></dict></dict></dict></plist>
